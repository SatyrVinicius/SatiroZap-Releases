{
  "name": "whatsapp-message-scheduler",
  "private": true,
  "version": "3.0.0",
  "description": "Desktop application for scheduling WhatsApp messages with automatic sending",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.20",
    "sql.js": "^1.14.2",
    "pino": "^9.6.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whatsapp.scheduler",
    "productName": "WhatsApp Scheduler",
    "directories": {
      "output": "build_out"
    },
    "compression": "store",
    "artifactName": "WhatsApp-Scheduler-Setup-${version}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "assets/**/*",
      "public/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "icons"
      }
    ],
    "asar": true
  }
}